# Copy to .env and fill in the keys you actually use.
# Keys are NEVER hardcoded in code; they are read from environment / .env only.

# SoMark cloud document-intelligence API (https://somark.cn)
SOMARK_API_KEY=

# Mistral OCR API (https://mistral.ai)
# Note: the mistral backend is synchronous and has no task_id, so re-running
# the same file re-uploads and re-bills. Only somark resumes.
MISTRAL_API_KEY=

# Firecrawl API (https://firecrawl.dev) — adapter is still a TODO skeleton
FIRECRAWL_API_KEY=

# Default backend when --backend is omitted: somark | paddleocr | mistral | firecrawl
DOCFLOW_DEFAULT_BACKEND=paddleocr
